#!/usr/bin/env node
const { platform, arch } = process;
const { execSync, spawnSync } = require("child_process");

function isMusl() {
  try {
    return execSync("ldd --version", { stdio: ['pipe', 'pipe', 'pipe'] }).includes("musl");
  } catch (err) {
    return err.stderr.includes("musl");
  }
}

const isLinuxMusl = platform === "linux" && isMusl();
const binPath = `@chromejs/browsercfg-${platform}-${arch}${isLinuxMusl ? "-musl" : ""}/browsercfg${platform === "win32" ? ".exe" : ""}`;

const result = spawnSync(
  require.resolve(binPath),
  process.argv.slice(2),
  {
    stdio: "inherit",
  },
);

if (result.error) {
  throw result.error;
}

process.exitCode = result.status;
